# Copia este archivo como ".env" y llena los valores. El archivo .env NO se sube al repositorio.

# Servidor de la API
PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bdinvestigacion

# Sesión de administrador (usa un texto largo y aleatorio)
JWT_SECRET=
JWT_EXPIRA=8h

# Dirección del frontend en React que puede consumir la API
CORS_ORIGIN=http://localhost:5173

# Dominio del correo institucional exigido al dar de alta administradores
DOMINIO_CORREO=itslerdo.edu.mx
